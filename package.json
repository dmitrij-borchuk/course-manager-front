      "react": "$react",
      "react-dom": "$react-dom"
    },
    "@react-pdf/renderer": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-materialize": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-is": "^18.3.1"
  }
}