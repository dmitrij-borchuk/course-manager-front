    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "firebase": "^9.3.0",
    "firebase-tools": "^9.22.0",
    "globals": "^17.5.0",
    "graphql": "^15.4.0",
    "jiti": "^2.6.1",
    "materialize-css": "1.0.0",
    "nanoid": "^3.1.28",
    "notistack": "^3.0.1",
    "npm-run-all": "^4.1.5",
