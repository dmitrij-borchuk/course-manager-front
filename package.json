    "react-toast-notifications": "^2.5.1",
    "tailwindcss": "^3.1.4",
    "typescript-eslint": "^8.59.0",
    "uuid": "^9.0.0",
    "web-vitals": "^0.2.4"
  },
  "browserslist": {
    "production": [
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      ">0.3%",
      "not ie 11",
      "not dead",
      "not op_mini all"
    ]
  },
