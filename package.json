    "@types/jest": "^30.0.0",
    "@types/loadable__component": "^5.13.3",
    "@types/node": "^20.19.39",
    "@types/react-helmet": "^6.1.5",
    "@types/react-router-dom": "^5.1.7",
    "@types/react-toast-notifications": "^2.4.0",
    "@vitejs/plugin-react": "^6.0.1",
    "cypress": "^10.11.0",
    "cypress-firebase": "^2.0.0",
    "firebase-admin": "^10.0.2",
    "graphql-tag": "^2.11.0",
